# Copie para .env e preencha. Nunca faça commit do .env.

# ---------- Concessionária ----------
# Pasta em src/tenants/ (ex.: demo, premium-example, ou o slug do seu cliente).
TENANT=demo

# ---------- Aplicação ----------
# URL pública do site, sem barra no final. Em produção: https://www.suaconcessionaria.com.br
APP_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# ---------- Banco de dados ----------
# Use só letras e números na senha (ela entra numa URL). Gere com: openssl rand -hex 24
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=senha
POSTGRES_DB=vitrine
# Usado quando o app roda fora do Docker (npm run dev). No Docker, o compose monta a URL sozinho.
DATABASE_URL=postgres://vitrine:senha@localhost:5432/vitrine

# ---------- Fotos ----------
# "local" guarda no disco do servidor (volume do Docker). "s3" usa S3/Cloudflare R2/MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Só quando STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://fotos.suaconcessionaria.com.br

# ---------- Deploy (VPS) ----------
# Domínio usado pelo Caddy para emitir o certificado HTTPS.
DOMAIN=suaconcessionaria.com.br
